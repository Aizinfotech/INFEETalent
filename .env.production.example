# Required for live Payload admin.
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://your-domain.com
PAYLOAD_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Required for persistent live admin sessions and edits.
DATABASE_URL=postgresql://user:password@host:5432/database

# Keep true for first deploy/schema creation, then turn off if using managed migrations.
PAYLOAD_ENABLE_SCHEMA_PUSH=true

CONTACT_FORM_RECIPIENT=info@infetalent.com
CAREER_FORM_RECIPIENT=hr@infetalent.com
