# Required in Vercel. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional, but useful when the admin is reachable from both apex and www domains.
PAYLOAD_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Local default.
DATABASE_URL=file:./infe-talent.sqlite

# Production admin/content edits need a hosted Postgres database, not SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/database
# PAYLOAD_ENABLE_SCHEMA_PUSH=true

CONTACT_FORM_RECIPIENT=info@infetalent.com
CAREER_FORM_RECIPIENT=hr@infetalent.com
